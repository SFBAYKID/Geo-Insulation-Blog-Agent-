# Geo Insulation blog agent — copy to .env.local; never commit filled credentials
# Fill blank credential fields locally. Never paste secrets into chat or commit this file.
# Source package is pending recovery; reconcile variable names with its Settings before running.
# Confirmed website: https://geo-insulation.com/
# Confirmed weekly schedule: Thursday 07:00 America/Los_Angeles.
# Schedule belongs in the systemd timer; keep it disabled until a clean test passes.

# Safe setup defaults
RUNTIME_ENVIRONMENT=test
TIMEZONE=America/Los_Angeles
STORAGE_DIR=storage
SLACK_LISTENER_ENABLED=false
WEBSITE_CHECKS_REMOTE=true
WEBSITE_PREVIEW_ENABLED=false
BASECAMP_DRAFT_READY_ENABLED=false
AIRTABLE_WRITE_ENABLED=false
COMPETITORS_ENABLED=false

# Slack — create a dedicated Geo app; do not reuse another bot's tokens
SLACK_CHANNEL_ID=C0B02721MNK
SLACK_TEST_CHANNEL_ID=C0B02721MNK
SLACK_PRODUCTION_CHANNEL_ID=
# Comma-separated approved Slack user IDs; verify before enabling requests
SLACK_APPROVER_IDS=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_TEAM_ID=
SLACK_CLIENT_ID=
SLACK_BOT_USER_ID=

# Basecamp — Launchpad OAuth credentials, not a generic API key
BLOG_QUEUE_SOURCE=basecamp
BASECAMP_ACCOUNT_ID=5395893
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REFRESH_TOKEN=
BASECAMP_PROJECT_ID=40851698
BASECAMP_TODOLIST_ID=0
BASECAMP_REVIEWER_ID=0

# OpenAI writing and editor; same key as image generation
WRITER_MODEL=gpt-6-luna
WRITER_PATCH_CORRECTIONS=true

# OpenAI — writing, editing and generated blog illustrations, always labeled Illustration:
OPENAI_API_KEY=
IMAGE_GENERATION_ENABLED=true
# Select a verified image model during setup
# IMAGE_MODEL uses the default until verified

# Airtable — separate Geo base; agent keyword reader stays read-only
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_VIEW_ID=

# Google — dedicated Geo service account for the pending keyword source
# Path to its private JSON credential file, not JSON text
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# Optional photo folder; not needed for the selected generated-image workflow
GOOGLE_DRIVE_FOLDER_ID=
# Drive keyword file ID and sync mapping belong in a separate worker config.
# Do not point this at a guessed file or another client's worker.

# Website — use the website repository here, NOT the blog-agent repository
WEBSITE_REPOSITORY=
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional integrations, left unconfigured
SERPAPI_API_KEY=
PAGESPEED_API_KEY=

PRODUCTION_DELIVERY_ENABLED=false
PUBLISHING_ENABLED=false
DAILY_ENABLED=false

# Set to droplet only in the isolated server configuration
DEPLOYMENT_TARGET=local
