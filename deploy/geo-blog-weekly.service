[Unit]
Description=Prepare the weekly Geo blog for production Slack approval
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=geo-blog
Group=geo-blog
WorkingDirectory=/opt/geo-blog
EnvironmentFile=/etc/geo-blog/agent.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/geo-blog/.venv/bin/python -m geo_blog.scheduled_preview --production --env-file /etc/geo-blog/agent.env
TimeoutStartSec=3600
UMask=0077
MemoryHigh=384M
MemoryMax=512M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geo-blog /opt/geo-blog
