{
  "display_information": {
    "name": "Geo Insulation Blog Agent",
    "description": "Geo blog writing and editing from supplied briefs, with Slack review",
    "background_color": "#163c42"
  },
  "features": {
    "bot_user": {
      "display_name": "Geo Insulation Blog Agent",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    }
  }
}
